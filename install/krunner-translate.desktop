[Desktop Entry]
Name=Translate
Comment=Translate words between languages, offline
X-KDE-ServiceTypes=Plasma/Runner
Type=Service
Icon=accessories-dictionary
X-KDE-PluginInfo-Name=krunner-translate
X-KDE-PluginInfo-Version=0.4.0
X-KDE-PluginInfo-License=GPL-3.0-or-later
X-KDE-PluginInfo-EnabledByDefault=true
X-Plasma-API=DBus2
X-Plasma-DBusRunner-Service=net.krunnertranslate.runner
X-Plasma-DBusRunner-Path=/runner
X-Plasma-Runner-Syntaxes=tr :q:
X-Plasma-Runner-Syntax-Descriptions=Translate a word or phrase. Languages are optional: tr es: casa, tr :es house, tr en:es house
X-Plasma-Request-Actions-Once=true
